# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# 모든 키는 선택 사항 — 없으면 해당 소스만 건너뜁니다.

# USDA NASS QuickStats (작황 등급) — 무료 발급: https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# Reddit (원자재 토론 감성 수집기 collect_reddit.py — 앞으로 쌓기용, 백테스트 미사용)
# https://www.reddit.com/prefs/apps 에서 'script' 유형 앱 생성 → client id(앱 이름 아래 문자열)·secret
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=commodity-lab/1.0 by <your_reddit_username>

# EIA Open Data (주간 재고) — 무료 발급: https://www.eia.gov/opendata
EIA_API_KEY=
