# ---- 가상환경 · 캐시 ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
node_modules/

# ---- 비밀정보: API 키는 .env 에만 (형식은 .env.example) — GitHub에 올리지 않고 따로 옮김 ----
.env
.env.*
!.env.example

# ---- 로컬 도구 설정 (PC 경로 포함) ----
.claude/
.omc/
.vscode/
.idea/

# ---- 데이터 (2026-10-30 사용자 결정: 회사 노트북으로 옮겨 바로 구동하도록 data/ 전체 추적 — 사내 정보 없음 확인) ----
# 제외: 기관 리포트 원문(WASDE·STEO PDF·엑셀 약 1.1GB) — 대시보드는 파싱 결과(data/reports/*.parquet)만 읽음.
#       원문이 필요하면 multimodal.py 수집으로 다시 받음.
data/reports/raw/

# ---- 생성물 · 임시 ----
*.log
docs/발표/_demo_tmp/

# ---- OS · 오피스 임시 파일 ----
Thumbs.db
desktop.ini
.DS_Store
~$*

# ---- 사내 교육 자료: 올리지 않음 (2026-10-30 사용자 요청) ----
docs/교육 내용/
docs/사내교육/
*사내교육*/

# 로컬 LLM 계층 (llm/): 전문가 의견·질의 기록은 사내 정보, 그림은 재생성 가능
data/expert/
